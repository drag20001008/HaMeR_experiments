diff --git a/hamer/models/components/lora.py b/hamer/models/components/lora.py
new file mode 100644
index 0000000..f9dbbc8
--- /dev/null
+++ b/hamer/models/components/lora.py
@@ -0,0 +1,55 @@
+"""Minimal LoRA wrapper for the HaMeR ViT backbone.
+
+Freezes the wrapped nn.Linear's original weight/bias and adds a low-rank
+additive path (B @ A), zero-initialized so the wrapped module starts as an
+exact identity to the un-wrapped linear layer.
+"""
+import torch
+import torch.nn as nn
+
+
+class LoRALinear(nn.Module):
+    def __init__(self, base: nn.Linear, r: int = 8, alpha: int = 16):
+        super().__init__()
+        self.base = base
+        for p in self.base.parameters():
+            p.requires_grad_(False)
+        self.r = r
+        self.scale = alpha / r
+        self.lora_A = nn.Linear(base.in_features, r, bias=False)
+        self.lora_B = nn.Linear(r, base.out_features, bias=False)
+        nn.init.kaiming_uniform_(self.lora_A.weight, a=5 ** 0.5)
+        nn.init.zeros_(self.lora_B.weight)
+
+    def forward(self, x):
+        return self.base(x) + self.scale * self.lora_B(self.lora_A(x))
+
+
+def apply_lora_to_vit(backbone: nn.Module, r: int = 8, alpha: int = 16,
+                       targets=('qkv', 'proj', 'fc1', 'fc2')) -> int:
+    """In-place replace target nn.Linear submodules inside backbone.blocks with
+    LoRALinear. Returns the number of layers wrapped."""
+    n_wrapped = 0
+    for block in backbone.blocks:
+        for name in targets:
+            # 'proj' exists both on attn (attn.proj) and elsewhere; only patch attn.proj here
+            module_holder, attr = (block.attn, name) if hasattr(block, 'attn') and hasattr(block.attn, name) else (None, None)
+            if module_holder is None and hasattr(block, 'mlp') and hasattr(block.mlp, name):
+                module_holder, attr = block.mlp, name
+            if module_holder is None:
+                continue
+            base_linear = getattr(module_holder, attr)
+            if not isinstance(base_linear, nn.Linear) or isinstance(base_linear, LoRALinear):
+                continue
+            setattr(module_holder, attr, LoRALinear(base_linear, r=r, alpha=alpha))
+            n_wrapped += 1
+    return n_wrapped
+
+
+def lora_parameters(backbone: nn.Module):
+    params = []
+    for m in backbone.modules():
+        if isinstance(m, LoRALinear):
+            params += list(m.lora_A.parameters())
+            params += list(m.lora_B.parameters())
+    return params
diff --git a/hamer/models/components/beta_context_adapter.py b/hamer/models/components/beta_context_adapter.py
new file mode 100644
index 0000000..0e78f17
--- /dev/null
+++ b/hamer/models/components/beta_context_adapter.py
@@ -0,0 +1,31 @@
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+
+
+class BetaContextAdapter(nn.Module):
+    """Zero-init low-rank adapter that injects MANO shape (beta) conditioning
+    into the ViT context tokens fed to the cross-attention MANO head.
+
+    At init this module is the identity function (proj_z and up are zero
+    initialized), so plugging it in does not change the pretrained model's
+    behavior until it is fine-tuned.
+    """
+
+    def __init__(self, d_ctx=1280, r=64, d_z=128, d_beta=10):
+        super().__init__()
+        self.enc = nn.Sequential(
+            nn.Linear(d_beta, 128), nn.SiLU(), nn.Linear(128, d_z)
+        )
+        self.norm = nn.LayerNorm(d_ctx)
+        self.down = nn.Linear(d_ctx, r)
+        self.proj_z = nn.Linear(d_z, r)
+        self.up = nn.Linear(r, d_ctx)
+        nn.init.zeros_(self.proj_z.weight); nn.init.zeros_(self.proj_z.bias)
+        nn.init.zeros_(self.up.weight);     nn.init.zeros_(self.up.bias)
+
+    def forward(self, ctx, beta):            # ctx [B,N,d_ctx], beta [B,d_beta]
+        z = self.enc(beta)                    # [B,d_z]
+        h = self.down(self.norm(ctx))         # [B,N,r]
+        h = h + self.proj_z(z).unsqueeze(1)
+        return ctx + self.up(F.gelu(h))
